rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function canManage() { return role() == 'EDITOR' || role() == 'SUPER_ADMIN'; }
    match /legal/{allPaths=**} {
      allow read: if resource.metadata.published == 'true';
      allow create, update: if canManage() && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('(application/pdf|image/(jpeg|png|webp))');
      allow delete: if role() == 'SUPER_ADMIN';
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
