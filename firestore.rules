rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return signedIn() ? request.auth.token.role : null;
    }

    function isSuperAdmin() {
      return role() == 'SUPER_ADMIN';
    }

    function isEditor() {
      return role() == 'EDITOR' || isSuperAdmin();
    }

    function isReviewer() {
      return role() == 'REVIEWER' || isSuperAdmin();
    }

    function validStatus(s) {
      return s in [
        'VERIFIED',
        'PARTIALLY_VERIFIED',
        'PENDING',
        'INCORRECT_REPLACED',
        'DUPLICATE'
      ];
    }

    function validVerifiedRecord(data) {
      return data.verificationStatus != 'VERIFIED'
        || (
          data.officialSourceUrl is string
          && data.officialSourceUrl.size() > 0
          && data.sourceCheckedAt is string
          && data.sourceCheckedAt.size() > 0
        );
    }

    function validPublication(data) {
      return data.published == false
        || (
          data.published == true
          && data.verificationStatus == 'VERIFIED'
          && data.officialSourceUrl is string
          && data.officialSourceUrl.size() > 0
          && data.sourceCheckedAt is string
          && data.sourceCheckedAt.size() > 0
        );
    }

    match /legalInstruments/{id} {

      // Public users can read only published and verified records.
      // Editors and Reviewers can also read unpublished records.
      allow read: if (
        resource.data.published == true
        && resource.data.verificationStatus == 'VERIFIED'
      ) || isEditor() || isReviewer();

      // Editors can create only PENDING unpublished drafts.
      allow create: if isEditor()
        && request.resource.data.id is string
        && request.resource.data.id == id
        && request.resource.data.verificationStatus == 'PENDING'
        && request.resource.data.published == false;

      // Editors can edit only existing PENDING drafts.
      // Reviewers can verify and publish after source details are recorded.
      allow update: if (

        (
          isEditor()
          && resource.data.verificationStatus == 'PENDING'
          && resource.data.published == false
          && request.resource.data.verificationStatus == 'PENDING'
          && request.resource.data.published == false
          && request.resource.data.id == resource.data.id
        )

        ||

        (
          isReviewer()
          && request.resource.data.id == resource.data.id
          && validStatus(request.resource.data.verificationStatus)
          && validPublication(request.resource.data)
          && validVerifiedRecord(request.resource.data)
        )
      );

      // Only Super Admin can delete legal records.
      allow delete: if isSuperAdmin();
    }

    match /legalSources/{id} {
      allow read: if isEditor() || isReviewer();
      allow create, update: if isEditor();
      allow delete: if isSuperAdmin();
    }

    match /legalAttachments/{id} {
      allow read: if isEditor() || isReviewer();
      allow write: if isEditor();
    }

    match /verificationRecords/{id} {
      allow read: if isEditor() || isReviewer();
      allow create: if isReviewer();
      allow update, delete: if isSuperAdmin();
    }

    match /reviewEvents/{id} {
      allow read: if isEditor() || isReviewer();
      allow create: if isReviewer();
      allow update, delete: if isSuperAdmin();
    }

    match /users/{uid} {
      allow read: if (
        signedIn() && request.auth.uid == uid
      ) || isSuperAdmin();

      // Users cannot grant themselves roles.
      allow write: if false;
    }

    // Deny all unspecified access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
